# `make setup` writes a .env with a fresh dev key and a token for "my-app"
# (python -m notify_hub.keys). These are the variables it sets, plus the optional ones.

# EC P-256 private key, PEM (newlines as \n inside double quotes).
NOTIFY_VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# A mailto: or https: URL: the push services contact it if something goes wrong.
# Apple rejects placeholders and localhost.
NOTIFY_VAPID_SUBJECT=mailto:you@example.com

# App name → sha256 hex of its token. The token goes in the app's NOTIFY_TOKEN.
NOTIFY_APPS='{"my-app": "<sha256 of the token>"}'

# Default: SQLite in ./notify.db
# NOTIFY_DATABASE_URL=postgresql+psycopg://notify:notify@localhost:5432/notify
# NOTIFY_DEFAULT_TTL=86400
# NOTIFY_LOG_LEVEL=INFO
# NOTIFY_LOG_JSON=false
