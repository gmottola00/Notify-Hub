.DEFAULT_GOAL := help
SHELL := /bin/bash

PY  := uv run
SRC := src/notify_hub

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

# --- setup -------------------------------------------------------------------

.PHONY: dev setup dev-keys
dev: ## Install with dev and postgres extras
	uv sync --all-extras

setup: dev ## Everything needed to work on the hub; writes .env with dev keys
	@test -f .env || ($(PY) python -m notify_hub.keys my-app > .env && echo ".env written with a dev VAPID key and a token for my-app")
	@echo "Ready: make run"

dev-keys: ## Print a dev VAPID key and tokens: make dev-keys APPS="app1 app2"
	$(PY) python -m notify_hub.keys $(APPS)

# --- running -----------------------------------------------------------------

.PHONY: run
run: ## Hub on :8300, reloading (SQLite in ./notify.db)
	$(PY) uvicorn notify_hub.api.app:app --reload --port 8300

# --- database ----------------------------------------------------------------

.PHONY: db-revision
db-revision: ## New autogenerated revision: make db-revision MSG="add x"
	@test -n "$(MSG)" || (echo 'usage: make db-revision MSG="..."' && exit 1)
	$(PY) python -c "from alembic import command; from notify_hub.settings import get_settings; from notify_hub.db.migrate import alembic_config; command.revision(alembic_config(get_settings().database_url), message='$(MSG)', autogenerate=True)"

# --- quality -----------------------------------------------------------------

.PHONY: lint format format-check typecheck test check
lint: ## Lint
	$(PY) ruff check $(SRC) tests

format: ## Format
	$(PY) black $(SRC) tests
	$(PY) isort $(SRC) tests

format-check: ## Verify formatting
	$(PY) black --check $(SRC) tests
	$(PY) isort --check-only $(SRC) tests

typecheck: ## Type-check
	$(PY) mypy $(SRC)

test: ## Run the tests
	$(PY) pytest -q

check: format-check lint typecheck test ## Everything CI runs

# --- docker ------------------------------------------------------------------

.PHONY: image
image: ## Build the image locally
	docker build -f docker/backend.Dockerfile -t notify-backend:dev .

.PHONY: clean
clean: ## Remove caches
	rm -rf build/ dist/ *.egg-info .pytest_cache/ .mypy_cache/ .ruff_cache/ htmlcov/ .coverage
	find . -type d -name __pycache__ -not -path './.venv/*' -exec rm -rf {} + 2>/dev/null || true
